{
  "name": "yomira-workspace",
  "version": "1.0.0",
  "description": "Yomira - Universal Comic & Manga Reader with Multi-Device Sync (PC & Android)",
  "private": true,
  "workspaces": [
    "core",
    "pc",
    "android"
  ],
  "scripts": {
    "build:core": "npm --workspace=core run build",
    "dev:pc": "npm --workspace=pc run dev",
    "dev:android": "npm --workspace=android run dev",
    "build:pc": "npm --workspace=pc run build",
    "build:android": "npm --workspace=android run build",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "keywords": [
    "manga",
    "webtoon",
    "comics",
    "reader",
    "sync",
    "google-drive"
  ],
  "author": "Yomira Team",
  "license": "MIT"
}
