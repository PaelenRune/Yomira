<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app language capability (API 33+): exposes English and Turkish in the
     system language shortcut and documents the supported resource set. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="tr" />
</locale-config>
