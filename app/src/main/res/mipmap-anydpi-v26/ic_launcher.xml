<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon: deep OLED black background (#06050C) with the glowing
    neon portal & book foreground, plus a monochrome layer for Android 13+
    themed icons. minSdk 26, so the adaptive icon is the only variant needed.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>