<?xml version="1.0" encoding="utf-8"?>
<!--
    Yomira launcher foreground: a glowing neon portal above an open book.
    The portal is rendered as concentric neon rings (Neon Purple #9D4EDD fading
    into Fuchsia #FF007F) with layered halo strokes for the glow, so the icon
    reads as "parlayan neon" on any launcher background without raster assets.
    Everything lives inside the 66dp adaptive-icon safe zone (21dp..87dp).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft bloom behind the book -->
    <path android:pathData="M29,74 a25,9 0 1,0 50,0 a25,9 0 1,0 -50,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="74"
                android:gradientRadius="26">
                <item android:offset="0" android:color="#559D4EDD" />
                <item android:offset="1" android:color="#009D4EDD" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Portal halo ring (outer glow) -->
    <path
        android:fillType="evenOdd"
        android:pathData="M33.5,42 a20.5,20.5 0 1,0 41,0 a20.5,20.5 0 1,0 -41,0 M38,42 a16,16 0 1,0 32,0 a16,16 0 1,0 -32,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="21.5"
                android:endX="54"
                android:endY="62.5">
                <item android:offset="0" android:color="#40FF007F" />
                <item android:offset="0.55" android:color="#4D9D4EDD" />
                <item android:offset="1" android:color="#40FF007F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Portal core: soft interior glow -->
    <path android:pathData="M40.5,42 a13.5,13.5 0 1,0 27,0 a13.5,13.5 0 1,0 -27,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="28.5"
                android:endX="54"
                android:endY="55.5">
                <item android:offset="0" android:color="#4D9D4EDD" />
                <item android:offset="1" android:color="#1FFF007F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main portal ring: neon purple to fuchsia -->
    <path
        android:fillType="evenOdd"
        android:pathData="M37,42 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0 M40,42 a14,14 0 1,0 28,0 a14,14 0 1,0 -28,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="25"
                android:endX="54"
                android:endY="59">
                <item android:offset="0" android:color="#C77DFF" />
                <item android:offset="0.55" android:color="#9D4EDD" />
                <item android:offset="1" android:color="#FF007F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Neon highlight arc over the top of the ring -->
    <path
        android:pathData="M43,31 A15.5,15.5 0 0,1 65,31"
        android:strokeColor="#F3E5FF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Fuchsia energy arc under the ring -->
    <path
        android:pathData="M43,53 A15.5,15.5 0 0,0 65,53"
        android:strokeColor="#FF3D9A"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Open book: left page -->
    <path android:pathData="M31,69 C37,64.5 46.5,64.5 53,68.5 L53,79 C46.5,75 37,75 31,79 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="64"
                android:endX="53"
                android:endY="80">
                <item android:offset="0" android:color="#A86BEE" />
                <item android:offset="1" android:color="#7B2CBF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Open book: right page -->
    <path android:pathData="M77,69 C71,64.5 61.5,64.5 55,68.5 L55,79 C61.5,75 71,75 77,79 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="55"
                android:startY="64"
                android:endX="77"
                android:endY="80">
                <item android:offset="0" android:color="#FF3D9A" />
                <item android:offset="1" android:color="#D10068" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Page lines -->
    <path
        android:pathData="M35.5,70.6 C39.5,68.9 45,69 49.5,71"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M72.5,70.6 C68.5,68.9 63,69 58.5,71"
        android:strokeColor="#66FFFFFF"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Spine -->
    <path
        android:pathData="M53,68.5 L55,68.5 L55,79 L53,79 Z"
        android:fillColor="#EFE6FF" />

    <!-- Sparkles -->
    <path
        android:pathData="M32,29.8 C32.6,31.9 32.6,31.9 35.2,33 C32.6,34.1 32.6,34.1 32,36.2 C31.4,34.1 31.4,34.1 28.8,33 C31.4,31.9 31.4,31.9 32,29.8 Z"
        android:fillColor="#FFF3C4" />
    <path
        android:pathData="M77,51.8 C77.6,53.9 77.6,53.9 80.2,55 C77.6,56.1 77.6,56.1 77,58.2 C76.4,56.1 76.4,56.1 73.8,55 C76.4,53.9 76.4,53.9 77,51.8 Z"
        android:fillColor="#FFB0E0" />
    <path
        android:pathData="M72,23.8 C72.6,25.9 72.6,25.9 75.2,27 C72.6,28.1 72.6,28.1 72,30.2 C71.4,28.1 71.4,28.1 68.8,27 C71.4,25.9 71.4,25.9 72,23.8 Z"
        android:fillColor="#FFFFFF" />
</vector>